# Production — https://gais.oceanspace.co.id (MySQL, Redis, S3). Panduan: docs/s3-production.md
# Pertahankan APP_KEY production yang sudah dipakai; jangan generate ulang saat deploy.
# Email belum aktif sampai kredensial SMTP tersedia (MAIL_MAILER=log).

APP_NAME=GAIS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gais.oceanspace.co.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_gais
DB_USERNAME=dev
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
# Production S3: FILESYSTEM_DISK=s3 and PUBLIC_FILESYSTEM_DRIVER=s3.
# Disk public stores uploads; disk s3 stores private QR PDFs, audit workbooks, and exports.
PUBLIC_FILESYSTEM_DRIVER=s3
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Prefix default diturunkan dari APP_NAME (gais_database_, gais_cache_, gais_horizon:). Isi bila Redis
# dipakai aplikasi/instance lain; cache:clear menjalankan FLUSHDB di REDIS_CACHE_DB.
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_PREFIX=
# HORIZON_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Masa berlaku kode + magic link login email (detik). Tombol login Email hanya muncul bila MAIL_MAILER bukan log/array.
EMAIL_LOGIN_EXPIRES_IN=600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=gais
AWS_ENDPOINT=https://storage.completeselular.com
AWS_URL=https://storage.completeselular.com/gais
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Observability — Horizon di /horizon; QUEUE_CONNECTION=redis
HORIZON_PATH=horizon
LOG_VIEWER_ENABLED=true
LOG_VIEWER_PATH=log-viewer
# Kosongkan agar memakai domain stateful Sanctum (dari APP_URL). Isi (pisah koma)
# bila app dibuka dari host lain, mis. domain .test Herd, agar API Log Viewer tidak 403.
LOG_VIEWER_API_STATEFUL_DOMAINS=

# Akun GA bersama (username, pisah koma): nama & jabatannya dikosongkan di PDF BA
# supaya diisi tangan oleh staf GA yang menandatangani.
GA_SHARED_ACCOUNT_USERNAMES=adminga

# WhatsApp — WagHub Gateway
WAG_URL=https://waghub.mekayastudio.com
WAG_TOKEN=
WHATSAPP_OTP_TTL_MINUTES=5
WA_CONNECT_TIMEOUT=5
WA_API_TIMEOUT=15
WHATSAPP_DEFAULT_TARGET=

# DatabaseSeeder Super Admin — production wajib isi password jika men-seed
# SEED_SUPER_ADMIN_USERNAME=admin
# SEED_SUPER_ADMIN_EMAIL=admin@dev.com
# SEED_SUPER_ADMIN_NAME="Super Admin"
# SEED_SUPER_ADMIN_PASSWORD=

# Database legacy sumo-web untuk `php artisan sumo:import` (lihat database/sumo/README.md)
SUMO_DB_DATABASE=db_sumo
# SUMO_DB_HOST=, SUMO_DB_PORT=, SUMO_DB_USERNAME=, SUMO_DB_PASSWORD=, SUMO_DB_PREFIX= mengikuti DB_* bila kosong
