APP_NAME=GAIS
APP_ENV=staging
# Buat sekali di server: php artisan key:generate (jangan ganti setelah ada data terenkripsi/sesi).
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-gais.oceanspace.co.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_gais_staging
DB_USERNAME=
DB_PASSWORD=

# Sesi dan cache di Redis; staging dibuka lewat HTTPS.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk public lokal butuh: php artisan storage:link
PUBLIC_FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Prefix khusus staging agar tidak bentrok bila Redis dipakai aplikasi/instance lain.
# cache:clear menjalankan FLUSHDB di REDIS_CACHE_DB, jadi pakai nomor DB sendiri bila Redis berbagi.
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=gais_staging_database_
CACHE_PREFIX=gais_staging_cache_
HORIZON_PREFIX=gais_staging_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
EMAIL_LOGIN_EXPIRES_IN=600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HORIZON_PATH=horizon
LOG_VIEWER_ENABLED=true
LOG_VIEWER_PATH=log-viewer
LOG_VIEWER_API_STATEFUL_DOMAINS=

GA_SHARED_ACCOUNT_USERNAMES=adminga

# WhatsApp — biarkan WAG_TOKEN kosong bila database staging berisi salinan data production,
# supaya pengingat terjadwal tidak terkirim ke nomor asli.
WAG_URL=https://waghub.mekayastudio.com
WAG_TOKEN=
WHATSAPP_OTP_TTL_MINUTES=5
WA_CONNECT_TIMEOUT=5
WA_API_TIMEOUT=15
WHATSAPP_DEFAULT_TARGET=

# Staging bukan production, jadi seeder memakai kata sandi "password" bila ini kosong.
# Wajib diisi karena staging bisa diakses publik.
SEED_SUPER_ADMIN_USERNAME=admin
SEED_SUPER_ADMIN_EMAIL=admin@dev.com
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_PASSWORD=

SUMO_DB_DATABASE=db_sumo
